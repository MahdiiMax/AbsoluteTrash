#!/usr/bin/env php
<?php

declare(strict_types=1);

$base = dirname(__DIR__);
require $base . '/vendor/autoload.php';

$app = require $base . '/bootstrap/app.php';

$input = new Trash\Console\Input($argv);
$output = new Trash\Console\Output();

$registry = $app->make(Trash\Console\CommandRegistry::class);
exit($registry->run($input, $output));