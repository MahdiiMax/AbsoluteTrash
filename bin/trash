#!/usr/bin/env php
<?php

declare(strict_types=1);

$base = dirname(__DIR__);
require $base . '/vendor/autoload.php';
$app = require $base . '/bootstrap/app.php';

$command = $argv[1] ?? null;

match ($command) {
    'migrate'       => $app->make(Trash\Database\Migrator::class)->migrate(),
    'migrate:fresh' => $app->make(Trash\Database\Migrator::class)->fresh(),
    default         => fwrite(STDERR, "Usage: php bin/trash migrate|migrate:fresh\n"),
};
