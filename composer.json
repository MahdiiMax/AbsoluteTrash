{
  "name": "mahdiimax/absolute-trash",
  "description": "Absolute Trash — a hand-built PHP 8.3 MVC framework.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "psr/container": "^2.0",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5.12"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Trash\\": "framework/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
